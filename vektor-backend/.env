# VEKTOR Intelligence — Backend Environment Variables
# Copy this file to .env and fill in the values
# NEVER commit .env to git

# ─── LLM APIs ───────────────────────────────────────────────
# Gemini API key from https://aistudio.google.com
GEMINI_API_KEY=API

# ─── Firebase ────────────────────────────────────────────────
# Full Firebase service account JSON as a single-line string
# Get from Firebase Console → Project Settings → Service Accounts → Generate new private key
# Minify the JSON and paste the entire thing as the value
FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"vektor-inteligence",...}

# ─── App Config ──────────────────────────────────────────────
# development | production
# In development, Firebase token verification is relaxed (any non-empty token accepted)
ENVIRONMENT=development

# Comma-separated list of allowed frontend origins for CORS
# In development: http://localhost:3000
# In production: your Vercel deployment URL
ALLOWED_ORIGINS=http://localhost:3000

# Port (Railway sets this automatically — do not set manually on Railway)
PORT=8000
